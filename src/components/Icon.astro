const markup = paths[name] ?? paths['spark'];
const style = size ? `font-size:${typeof size === 'number' ? `${size}px` : size}` : undefined;
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  style={style}
  set:html={(label ? `<title>${label}</title>` : '') + markup}
/>
