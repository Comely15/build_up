---
/**
 * 푸터. #161616, 상단 여백 → 소개/메뉴 4열 → hairline → 1200px 워드마크 → 하단 바.
 */
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { footer, site } from '../data/content';
const isExt = (h: string) => /^https?:/.test(h);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size={56} class="footer-brand__logo" />
        <p class="footer-brand__text">{site.description}</p>
        <p class="footer-brand__motto">{site.motto}</p>
      </div>
      {
        footer.columns.map((col) => (
          <div class="footer-col">
            <p class="footer-col__title">{col.title}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href} rel={isExt(l.href) ? 'noopener' : undefined} target={isExt(l.href) ? '_blank' : undefined}>
                    {l.label}
                    {isExt(l.href) && <Icon name="arrow-up-right" size={12} />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <hr class="footer-rule" />

    <div class="footer-contact">
      <div class="footer-contact__item">
        <Icon name="pin" size={18} />
        <span>{site.addressShort}</span>
      </div>
      <a class="footer-contact__item" href={`mailto:${site.email}`}>
        <Icon name="mail" size={18} />
        <span>{site.email}</span>
      </a>
      <a class="footer-contact__item" href={site.phoneHref}>
        <Icon name="phone" size={18} />
        <span>{site.phone}</span>
      </a>
    </div>

    <div class="footer-logo" aria-hidden="true">
      <Wordmark as="div" size={360} class="footer-logo__mark" text="BUILD UP" />
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom__legal">
        <span>© {site.year} {site.company}. All rights reserved.</span>
      </div>
      <ul class="footer-social">
        {
          footer.social.map((s) => (
            <li>
              <a href={s.href} aria-label={s.name} rel="noopener" target="_blank">
                <Icon name={s.name} size={22} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-footer);
    color: var(--c-white);
    padding: clamp(80px, 10vw, 140px) 0 var(--s-7);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    column-gap: 40px;
    row-gap: 48px;
  }
  .footer-brand :global(.footer-brand__logo) {
    color: var(--c-white);
  }

  .footer-brand :global(.logo__ko) {
    color: rgba(255, 255, 255, 0.7);
  }
  .footer-brand__text {
    max-width: 380px;
    margin: var(--s-3) 0 var(--s-2);
    font-size: var(--t-small);
    color: rgba(255, 255, 255, 0.8);
  }
  .footer-brand__motto {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-small);
    color: var(--c-navy-soft);
    margin: 0;
  }
  .footer-col__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-lead);
    margin: 0 0 10px;
  }
  .footer-col li {
    margin-bottom: 5px;
  }
  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--t-small);
    line-height: 1.2;
    padding: 6px 0;
    color: var(--c-white);
    opacity: 0.92;
    transition: opacity var(--dur) var(--ease);
  }
  .footer-col a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-rule {
    border-top-color: rgba(255, 255, 255, 0.25);
    margin-top: var(--s-7);
  }
  .footer-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 44px;
    padding: var(--s-5) 0 0;
    font-size: var(--t-small);
  }
  .footer-contact__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.85);
  }
  .footer-contact__item :global(.icon) {
    color: var(--c-navy-soft);
  }
  a.footer-contact__item:hover {
    color: var(--c-white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-logo {
    padding: var(--s-7) 0 var(--s-6);
    overflow: hidden;
  }
  :global(.footer-logo__mark) {
    font-size: clamp(56px, 17.5vw, 250px) !important;
    line-height: 0.8;
    transform: translateX(-0.04em);
    color: rgba(255, 255, 255, 0.95);
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 20px;
    font-size: var(--t-small);
  }
  .footer-social {
    display: flex;
    gap: 20px;
  }
  .footer-social a {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: var(--hairline) solid rgba(255, 255, 255, 0.4);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .footer-social a:hover {
    background: var(--c-white);
    color: var(--c-footer);
  }
  @media (max-width: 1000px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      row-gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
