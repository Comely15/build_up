---
/**
 * 오시는 길 지도 카드 — SVG 약도 + 역/도보/사무실 칩. 카드 전체가 네이버 지도 링크다.
 */
import Icon from '../Icon.astro';
import { sns, site } from '../../data/content';
---

<a class="map__card ui-chip" href={sns.map.apps[0].href} target="_blank" rel="noopener" data-reveal aria-label="네이버 지도에서 빌드업 미니스트리 위치 열기">
          <span class="map__art">
          <svg class="map__svg" viewBox="0 0 520 360" role="img" aria-hidden="true">
            <defs>
              <pattern id="mapgrid" width="26" height="26" patternUnits="userSpaceOnUse">
                <path d="M26 0H0v26" fill="none" stroke="rgba(31,47,82,0.06)" stroke-width="1" />
              </pattern>
            </defs>
            <rect width="520" height="360" fill="#eef1f7" />
            <rect width="520" height="360" fill="url(#mapgrid)" />
            <!-- 블록 -->
            <g fill="#e2e7f1">
              <rect x="20" y="24" width="150" height="120" rx="10" />
              <rect x="20" y="238" width="150" height="110" rx="10" />
              <rect x="212" y="24" width="130" height="66" rx="10" />
              <rect x="378" y="24" width="122" height="66" rx="10" />
              <rect x="212" y="238" width="130" height="110" rx="10" />
              <rect x="378" y="238" width="122" height="110" rx="10" />
            </g>
            <!-- 공원 블록 -->
            <rect x="378" y="118" width="122" height="94" rx="12" fill="#dbe8d6" />
            <g fill="#c4d9bc">
              <circle cx="410" cy="150" r="9" /><circle cx="440" cy="176" r="11" /><circle cx="472" cy="146" r="8" /><circle cx="404" cy="190" r="7" />
            </g>
            <!-- 도로 -->
            <g stroke="#ffffff" stroke-linecap="round" fill="none">
              <path d="M-10 200 H530" stroke-width="30" />
              <path d="M190 -10 V370" stroke-width="22" />
              <path d="M360 -10 V370" stroke-width="16" />
              <path d="M-10 108 H530" stroke-width="12" />
            </g>
            <g stroke="rgba(31,47,82,0.18)" stroke-dasharray="10 12" fill="none">
              <path d="M-10 200 H530" stroke-width="1.5" />
            </g>
            <text x="262" y="222" font-size="11" font-weight="600" fill="rgba(31,47,82,0.6)" font-family="Sora, Noto Sans KR, sans-serif">양산로</text>
            <!-- 도보 경로 -->
            <path d="M96 200 C 130 200, 170 196, 200 188 S 262 150, 296 140" fill="none" stroke="#2d4373" stroke-width="3" stroke-dasharray="1 8" stroke-linecap="round" />
            <!-- 역 -->
            <g transform="translate(96 200)">
              <circle r="18" fill="#ffffff" stroke="#1f2f52" stroke-width="2" />
              <circle r="7" fill="#00a84d" cx="-5" />
              <circle r="7" fill="#996cac" cx="5" />
            </g>
            <!-- 사무실 핀 -->
            <g transform="translate(296 128)">
              <ellipse cy="26" rx="14" ry="5" fill="rgba(31,47,82,0.18)" />
              <path d="M0 24 C -18 4 -20 -4 -20 -10 A 20 20 0 1 1 20 -10 C 20 -4 18 4 0 24 Z" fill="#2d4373" />
              <circle cy="-10" r="7" fill="#ffffff" />
            </g>
          </svg>
          <span class="map__chip map__chip--station">
            <strong>{sns.map.station}</strong>
            <span class="map__exits">
              {
                sns.map.lines.map((l) => (
                  <span class="map__exit">
                    <span class="map__line" style={`background:${l.color}`}>{l.name.replace('호선', '')}</span>
                    {l.exit}
                  </span>
                ))
              }
            </span>
          </span>
          <span class="map__chip map__chip--walk">
            <Icon name="walk" size={13} />
            {sns.map.walk}
          </span>
          <span class="map__chip map__chip--office">
            <strong>빌드업 미니스트리</strong>
            <span>길빌딩 2층 206호</span>
          </span>
          <span class="map__open">
            <Icon name="map" size={16} />
            네이버 지도에서 열기
            <Icon name="arrow-up-right" size={14} />
          </span>
          </span>
          <span class="map__foot">
            <span class="map__foot-name">{site.name}</span>
            <span class="map__foot-addr">{sns.map.address}</span>
          </span>
        </a>

<style>
  .map__card {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: block;
    border-radius: var(--r-quote);
    overflow: hidden;
    color: var(--c-ink);
    transition: transform var(--dur) var(--ease);
  }
  .map__card:hover {
    transform: translateY(-2px);
  }
  .map__art {
    display: block;
    position: relative;
    overflow: hidden;
  }
  .map__svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 520 / 360;
    transition: transform var(--dur-slow) var(--ease);
  }
  .map__card:hover .map__svg {
    transform: scale(1.02);
  }
  .map__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-small);
    color: var(--c-purple-ink);
    background: var(--c-white);
    padding: 6px 10px;
    border-radius: 999px;
    box-shadow: var(--shadow-chip);
    white-space: nowrap;
    pointer-events: none;
  }
  .map__chip--station {
    left: 6%;
    top: 62%;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    padding: 8px 11px;
    border-radius: 10px;
  }
  .map__chip--station strong {
    font-weight: 600;
    color: var(--c-ink);
  }
  .map__exits {
    display: inline-flex;
    gap: 8px;
  }
  .map__exit {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--c-ink-70);
  }
  .map__chip--walk {
    left: 35%;
    top: 40%;
    background: var(--c-purple);
    font-size: var(--t-small);
  }
  .map__chip--office {
    left: 62%;
    top: 24%;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 9px 12px;
    border-radius: 10px;
    color: var(--c-ink);
  }
  .map__chip--office span {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: var(--t-small);
    color: var(--c-ink-60);
  }
  .map__line {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    color: var(--c-white);
    font-size: var(--t-small);
    font-weight: 600;
  }
  .map__open {
    position: absolute;
    right: 16px;
    top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-small);
    color: var(--c-white);
    background: var(--c-ink-90);
    padding: 8px 12px;
    border-radius: 999px;
    opacity: 0.92;
    transition: opacity var(--dur) var(--ease);
  }
  .map__card:hover .map__open {
    opacity: 1;
  }
  .map__foot {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 20px 16px;
    background: var(--c-white);
    border-top: var(--hairline) solid var(--ui-line);
  }
  .map__foot-name {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-ink);
  }
  .map__foot-addr {
    font-size: var(--t-small);
    color: var(--c-ink-60);
  }
  @media (max-width: 960px) {
    .map__card {
      position: static;
      max-width: 520px;
    }
  }
  @media (max-width: 600px) {
    .map__chip--office {
      left: 58%;
      top: 20%;
    }
    .map__chip--station {
      left: 4%;
      top: 64%;
      padding: 6px 9px;
    }
    .map__exit {
      font-size: var(--t-small);
    }
    .map__open {
      font-size: var(--t-small);
      padding: 7px 10px;
    }
  }
</style>
