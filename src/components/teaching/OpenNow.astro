---
/**
 * 교육과정 히어로의 "지금 모집중" 카드. 모집중(open) 기수만 골라 날짜 블록 + 과정명 + 화살표로 나열한다.
 */
import Icon from '../Icon.astro';
import { courses } from '../../data/content';
/* 모집중 기수만. 모집중은 항상 일정이 있다(verify 가 검사) */
const open = courses.filter((c): c is typeof c & { start: string } => c.status === 'open' && !!c.start);
---

<div class="open ui-chip" slot="media">
      <div class="open__head">
        <p class="open__title">
          <span class="open__dot" aria-hidden="true"></span>
          지금 모집중
        </p>
      </div>
      <ul class="open__list">
        {
          open.map((c) => {
              const [, m, d] = c.start.split('-');
              const href = c.slug ? `/courses/${c.slug}/` : '#schedule';
              return (
                <li>
                  <a class="open__item" href={href}>
                    <span class="open__date">
                      <b>{Number(d)}</b>
                      <span>{Number(m)}월</span>
                    </span>
                    <span class="open__body">
                      <span class="open__name">{c.title}</span>
                      <span class="open__meta">{c.time}</span>
                    </span>
                    <Icon name="arrow-right" class="open__arrow" size={18} />
                  </a>
                </li>
              );
          })
        }
      </ul>
    </div>

<style>
  /* 히어로: 지금 모집중인 과정 — 행 전체가 링크, 날짜 블록 + 과정명 + 화살표 */
  .open {
    padding: 22px 22px 18px;
    border-radius: var(--r-quote);
  }
  .open__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .open__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-body);
    letter-spacing: -0.02em;
    color: var(--c-ink);
    margin: 0;
  }
  .open__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-navy);
    box-shadow: 0 0 0 0 rgba(41, 61, 105, 0.45);
    animation: open-pulse 2.2s var(--ease) infinite;
  }
  @keyframes open-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(41, 61, 105, 0.45);
    }
    70% {
      box-shadow: 0 0 0 9px rgba(41, 61, 105, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(41, 61, 105, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .open__dot {
      animation: none;
    }
  }
  .open__list {
    display: grid;
    gap: 6px;
  }
  .open__item {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 10px 12px 10px 10px;
    border-radius: 14px;
    background: var(--c-page);
    transition:
      background-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .open__item:hover {
    background: var(--c-card);
    transform: translateX(2px);
  }
  .open__item:hover :global(.open__arrow) {
    transform: translateX(4px);
    color: var(--c-navy);
  }
  .open__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: var(--c-navy);
    color: var(--c-white);
    line-height: 1;
  }
  .open__date b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-h4);
    letter-spacing: -0.03em;
  }
  .open__date span {
    font-size: var(--t-small);
    opacity: 0.85;
    margin-top: 3px;
  }
  .open__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .open__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-body);
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--c-ink);
  }
  .open__meta {
    font-size: var(--t-body);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--c-ink-70);
  }
  .open :global(.open__arrow) {
    color: var(--c-ink-70);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
</style>
