---
/**
 * 2026년 연간 일정 — 프로그램 4행 × 12개월. 막대 위치·줄 배정은 lib/schedule.ts 의 laneOf 가 계산한다.
 * 교육완료 막대는 링크가 아니다. 올해 일정이 없는 기수(추후모집 · 지난해)는 막대가 없다.
 */
import { teaching, courses, statusLabel } from '../../data/content';
import { byProgram, laneOf, inYear, label, fmt, range, rowId, months, todayPct, YEAR } from '../../lib/schedule';
---

<div class="tl" data-reveal>
        <div class="tl__head">
          <h3 class="tl__title">{teaching.schedule.timelineTitle}</h3>
          <p class="tl__lead">{teaching.schedule.timelineLead}</p>
          <ul class="tl__legend" aria-label="상태">
            <li><span class="tl__swatch tl__swatch--open"></span>모집중</li>
            <li><span class="tl__swatch tl__swatch--full"></span>모집완료</li>
            <li><span class="tl__swatch tl__swatch--done"></span>교육완료</li>
          </ul>
        </div>
        <div class="tl__grid">
          <div class="tl__months" aria-hidden="true">
            <span class="tl__rowlabel"></span>
            <div class="tl__track tl__track--months">
              {months.map((m) => <span class="tl__month">{m}</span>)}
            </div>
          </div>
          {
            byProgram.map(({ program }) => {
              /* 늦은 기수부터 배치해 겹칠 때 뒤 기수가 윗줄, 앞 기수가 아랫줄에 놓인다 */
              const mine = courses.filter((c) => c.kind === program.kind);
              const lanes = laneOf(mine.filter(inYear).sort((a, b) => (a.start < b.start ? 1 : -1)));
              /* 올해 막대가 하나도 없으면, 막대 자리에 점선 표를 놓는다: 일정이 없으면 "N기 추후모집", 내년 이후 일정이면 "2027년 N기 예정" */
              const soon = lanes.length === 0 ? mine.filter((c) => c.status !== 'done' && (!c.start || c.start.slice(0, 4) > String(YEAR))) : [];
              const soonLabel = (c: (typeof mine)[number]) => (c.start ? `${c.start.slice(0, 4)}년 ${label(c).gi} 예정` : `${label(c).gi} ${statusLabel.soon}`);
              return (
              <div class="tl__row">
                <span class="tl__rowlabel">{program.name}</span>
                <div class:list={['tl__track', { 'tl__track--2': lanes.some((x) => x.lane > 0) }]}>
                  {months.map(() => <span class="tl__cell" aria-hidden="true" />)}
                  {todayPct !== null && <span class="tl__today" style={`left:${todayPct}%`} aria-hidden="true" />}
                  {soon.map((c) => (
                    <a class="tl__bar tl__bar--soon tl__bar--lane0" style={`left:${todayPct ?? 0}%`} href={`#${rowId(c)}`} title={`${c.title} · ${range(c)} · ${statusLabel[c.status]}`}>
                      <span class="tl__bar-label">{soonLabel(c)}</span>
                    </a>
                  ))}
                  {lanes.map(({ c, lane, left, width }) => {
                    const { gi } = label(c);
                    const done = c.status === 'done';
                    const Bar = done ? 'span' : 'a';
                    return (
                      <Bar
                        class:list={['tl__bar', `tl__bar--${c.status}`, `tl__bar--lane${lane}`]}
                        style={`left:${left}%;width:${width}%`}
                        href={done ? undefined : `#${rowId(c)}`}
                        title={`${c.title} · ${range(c)} · ${statusLabel[c.status]}`}
                      >
                        <span class="tl__bar-label">{c.end ? gi : fmt(c.start)}</span>
                      </Bar>
                    );
                  })}
                </div>
              </div>
              );
            })
          }
        </div>
      </div>

<style>
  /* ---------- 연간 타임라인 ---------- */
  .tl {
    margin-bottom: var(--s-7);
    padding: 28px 28px 24px;
    border-radius: var(--r-quote);
    background: var(--c-white);
  }
  .tl__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 8px 20px;
    margin-bottom: 20px;
  }
  .tl__title {
    font-size: var(--t-h4);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .tl__lead {
    margin: 0;
    font-size: var(--t-body);
    color: var(--c-ink-90);
  }
  .tl__legend {
    display: flex;
    gap: 14px;
    font-size: var(--t-small);
    color: var(--c-ink-90);
  }
  .tl__legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .tl__swatch {
    width: 14px;
    height: 10px;
    border-radius: 3px;
    border: 2px solid var(--c-ink-90);
  }
  .tl__swatch--open {
    background: var(--c-ink);
  }
  .tl__swatch--done {
    background: rgba(0, 0, 0, 0.1);
    border-color: transparent;
  }
  .tl__grid {
    display: grid;
    gap: 6px;
    overflow-x: auto;
  }
  .tl__months,
  .tl__row {
    display: grid;
    grid-template-columns: 130px minmax(560px, 1fr);
    align-items: center;
    gap: 12px;
    padding-right: 28px;
  }
  .tl__rowlabel {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-small);
    letter-spacing: -0.01em;
    color: var(--c-ink);
  }
  .tl__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    height: 40px;
  }
  .tl__track--months {
    height: auto;
  }
  .tl__track--2 {
    height: 66px;
  }
  .tl__track--2 .tl__bar--lane1 {
    top: 36px;
  }
  .tl__month {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-small);
    color: var(--c-ink-90);
    padding-left: 4px;
    border-left: var(--hairline) solid var(--c-card-border);
  }
  .tl__cell {
    border-left: var(--hairline) solid var(--c-card-border);
    background: var(--c-slab);
  }
  .tl__cell:nth-child(even) {
    background: var(--c-page);
  }
  .tl__today {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 2px;
    background: var(--c-navy);
    z-index: 1;
    opacity: 0.92;
  }
  .tl__bar {
    position: absolute;
    top: 7px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    border-radius: 6px;
    border: 2px solid var(--c-ink-90);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--t-small);
    letter-spacing: -0.01em;
    white-space: nowrap;
    z-index: 2;
    transition: transform var(--dur) var(--ease);
  }
  .tl__bar:hover {
    transform: translateY(-2px);
  }
  .tl__bar--open {
    background: var(--c-ink);
    color: var(--c-white);
  }
  .tl__bar--full {
    background: var(--c-white);
    color: var(--c-ink);
  }
  .tl__bar--done {
    background: rgba(0, 0, 0, 0.1);
    border-color: transparent;
    color: var(--c-ink-90);
    cursor: default;
  }
  /* 추후모집: 일정이 없으니 오늘 선 옆에 점선 표만 둔다 (배지와 같은 점선 문법) */
  .tl__bar--soon {
    margin-left: 8px;
    background: var(--c-white);
    border-style: dashed;
    color: var(--c-ink-90);
  }
  .tl__bar--done:hover {
    transform: none;
  }
  @media (max-width: 960px) {
    .tl__head {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .tl__months,
    .tl__row {
      grid-template-columns: 90px minmax(520px, 1fr);
    }
  }
</style>
