---
/**
 * "BUILD UP" 워드마크 — 로고 이미지 옆이나 푸터 거대 타이포에 쓴다. 부모의 color 를 따른다.
 * 굵기는 600 (헤더·푸터 공통, 700 에서 한 단계 낮춤).
 */
interface Props {
  size?: number;
  class?: string;
  as?: 'span' | 'div';
  text?: string;
}
const { size = 20, class: className, as: Tag = 'span', text = 'BUILD UP' } = Astro.props;
---

<Tag class:list={['wordmark', className]} style={`font-size:${size}px`}>{text}</Tag>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.8;
    display: inline-block;
    white-space: nowrap;
    user-select: none;
  }
</style>
