---
/**
 * 위로가기 버튼. 한 화면(뷰포트 80%) 넘게 내려가면 우하단에 나타난다 (scripts/totop.ts).
 * 검정 90% 원형 필 + 흰 화살표, 그림자 없음. 과정 상세의 하단 신청 바가 떠 있으면 그만큼 위로 올라간다.
 */
import Icon from './Icon.astro';
---

<button class="totop" type="button" data-totop aria-label="맨 위로" hidden>
  <Icon name="arrow-up" size={22} />
</button>

<style>
  .totop {
    position: fixed;
    right: clamp(16px, 2.5vw, 28px);
    bottom: clamp(16px, 2.5vw, 28px);
    z-index: calc(var(--z-header) - 2);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--c-ink-90);
    color: var(--c-white);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      bottom var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .totop[hidden] {
    display: grid; /* hidden 속성 대신 opacity 로 페이드 — 클릭은 pointer-events 로 막는다 */
    pointer-events: none;
  }
  .totop.is-visible {
    opacity: 1;
    transform: none;
  }
  .totop:hover {
    background: var(--c-ink);
  }
  .totop--lifted {
    bottom: 84px;
  }
  .totop :global(.icon) {
    stroke-width: 2;
  }
</style>
